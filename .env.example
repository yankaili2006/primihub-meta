# primihub-meta 环境配置
# 复制此文件为 .env 并根据需要修改

# 数据库路径 (meta-simple SQLite)
DB_PATH=/data/fusion/simple

# 协作节点地址 (meta-simple)
COLLABORATE=http://127.0.0.1:7899/

# MySQL 配置 (meta-api)
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=meta
MYSQL_USER=root
MYSQL_PASSWORD=primihub

# Nacos 配置 (meta-api)
NACOS_HOST=nacos
NACOS_PORT=8848
NACOS_NAMESPACE=
